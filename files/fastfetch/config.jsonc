// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2,
        },
    },
    "display": {
        "separator": " -> ",
    },
    "modules": [
        {
            "type": "custom",
            "format": " \u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m       \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m",
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────────────────────────────────────────────┐",
        },
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "green",
        },
        {
            "type": "uptime",
            "key": "│ ├󰅐Uptime",
            "keyColor": "green",
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠CPU",
            "keyColor": "green",
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛GPU",
            "keyColor": "green",
        },
        {
            "type": "disk",
            "key": "│ ├disk",
            "keyColor": "green",
        },
        {
            "type": "memory",
            "key": "│ ├󰑭ram",
            "keyColor": "green",
        },
        {
            "type": "swap",
            "key": "│ ├󰓡swap",
            "keyColor": "green",
        },
        {
            "type": "sound",
            "key": "│ ├Sound",
            "keyColor": "green",
        },
        {
            "type": "display",
            "key": "│ └󰍹Display",
            "keyColor": "green",
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "yellow",
        },
        {
            "type": "kernel",
            "key": "  ├",
            "keyColor": "yellow",
        },
        {
            "type": "packages",
            "key": "  ├󰏖",
            "keyColor": "yellow",
        },
        {
            "type": "shell",
            "key": "  ├",
            "keyColor": "yellow",
        },
        {
            "type": "terminal",
            "key": "  └",
            "keyColor": "yellow",
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────┘",
        },
        "break",
        {
            "type": "custom",
            "format": " \u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m       \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m",
        },
    ],
}
