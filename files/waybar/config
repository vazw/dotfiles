{
    "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30,
    "output": ["*"],
    "margin": 0,
   //  "modules-left": ["pulseaudio#source", "wireplumber", "group/light", "tray"],
    "modules-left": ["pulseaudio#source", "tray"],
    "modules-center": ["sway/mode","custom/app_drawer", "sway/workspaces"],
    "modules-right": ["sway/language", "idle_inhibitor", "battery", "custom/blockheight", "clock", "custom/notification"], 
    
 
    "sway/mode": {
        "format": "[Mode] {}",
        "max-length": 200
    },
    "sway/workspaces": { 
        "format": "{icon}",
        "sort-by-number": true,
        "active-only": false,
        "all-outputs": true,
        "format-icons": {
            "urgent": "",
        },
        // "persistent-workspaces": {
        //     "1": [],
        // },
        "on-click": "activate",
    },
    "idle_inhibitor": {
        "format": "{icon}",
       "format-icons": {
            "activated": "󱋙",
            "deactivated": "󰌪"
        }
    },
    "tray": {
        "icon-size": 22,
        "spacing": 10
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{calendar}",
        "timezone": "Asia/Bangkok",
        "locale": "en_US.UTF-8",
        "calendar": {
                    "mode"          : "month",
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "on-click-right": "mode",
                    "format": {
                              "months":     "<span color='#ffead3'>{}</span>",
                              "days":       "<span color='#ecc6d9'>{}</span>",
                              "weeks":      "<span color='#99ffdd'>W{}</span>",
                              "weekdays":   "<span color='#ffcc66'>{}</span>",
                              "today":      "<span size='14pt' color='#ff6699' font='Hack Nerd Font Propo ExtraBold'><b>{}</b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-click-forward": "tz_up",
                    "on-click-backward": "tz_down",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
    },
    "backlight": {
        "format": "{icon}",
        "format-icons": ["", ""],
        "on-scroll-down": "~/.config/sway/scripts/brightness --dec",
        "on-scroll-up": "~/.config/sway/scripts/brightness --inc"
    },
    "backlight/slider": {
        "min": 1,
        "max": 100,
        "orientation": "horizontal",
        "on-scroll-down": "~/.config/sway/scripts/brightness --dec",
        "on-scroll-up": "~/.config/sway/scripts/brightness --inc"
    },
    "battery": {
        "states": {
            // "warning": 40,
            "critical": 30
        },       
        "format": "{icon}",
        "full-at": 100,
        "format-charging": "{icon}⚡{capacity}%",
        "format-plugged": "{icon}⚡",
        "format-full": "{icon}⚡",        
        "format-alt" : "{icon} {capacity}%",
        "format-time": "{H}:{m} hours",        
        "format-icons": ["", "", "", "", ""],
        "on-click": "~/.config/waybar/scripts/powerprofilecycle.sh",
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "on-scroll-up": "~/.config/sway/scripts/volume --inc",
        "on-scroll-down": "~/.config/sway/scripts/volume --dec"
    },
    "pulseaudio#sink": {
        "scroll-step": 1,
        "format": "{icon}",
        "format-bluetooth": "{icon}󰥰",
        "format-muted":"",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾", ""]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "~/.config/sway/scripts/volume --inc",
        "on-scroll-down": "~/.config/sway/scripts/volume --dec",
        "ignored-sinks": ["Easy Effects Sink"],
    },
    "pulseaudio#source": {
        "format": "{format_source}",
        "format-source": "<span color='#FF0000'><b></b></span>",
        "format-source-muted": "",
        "on-click": "pavucontrol",
        "on-scroll-up": "~/.config/sway/scripts/volume --inc",
        "on-scroll-down": "~/.config/sway/scripts/volume --dec",
        "ignored-sinks": ["Easy Effects Source"],
        "tooltip": true,
    },
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "",
        "on-click": "pavucontrol",
        "max-volume": 100,
        "scroll-step": 1,
        "format-muted":"",
        "format-icons": ["󰕿", "󰖀", "󰕾", ""],
        "on-scroll-up": "~/.config/sway/scripts/volume --inc",
        "on-scroll-down": "~/.config/sway/scripts/volume --dec"
    },
    "group/sound": {
        "orientation": "inherit",
    "drawer": {
        "transition-duration": 500,
        "transition-left-to-right": true,
    },
    "modules": [
        "wireplumber",
        "pulseaudio/slider",
    ]
    },
    "custom/blockheight": {
        "exec": "sleep 0.3 && ~/.config/waybar/scripts/blockheight.sh",
        "interval": 60,
        "tooltip": true,
    },
    "sway/language": {
        "format": "{shortDescription}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    },
    "group/light": {
        "orientation": "inherit",
    "drawer": {
        "transition-duration": 500,
        "transition-left-to-right": true,
    },
    "modules": [
        "backlight",
        "backlight/slider",
    ]
    },
    "custom/screenrecorder": {
        "exec": "$HOME/.config/waybar/waybar-screenrecorder/screenrecorder status",
        "interval": "once",
        "signal": 1,
        "return-type": "json",
        "tooltip": true,
        "format": "{}",
        "on-click": "$HOME/.config/waybar/waybar-screenrecorder/screenrecorder toggle fullscreen",
        "on-click-right": "$HOME/.config/waybar/waybar-screenrecorder/screenrecorder toggle region"
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/app_drawer": {
        "tooltip": true,
        "format": " ",
        "on-click": "swayr switch-window",
    }
}

