include catppuccin-mocha
# Apply gtk theming
exec_always nwg-look -a

# Set inner/outer gaps
gaps inner 0
gaps outer 0

# Hide titlebar on windows: 
default_border pixel 2
default_floating_border none
titlebar_border_thickness 1
smart_borders on
set $border pixel 2
# smart_gaps on
set $opacity 1
exec_always swaymsg split none
# exec_always swaymsg split none, layout tabbed 


# Default Font
# font pango:Noto Sans Regular 10
font pango:"Iosevka NFP SemiBold" Regular 11


# Set wallpaper:
# exec ~/.azotebg

# Title format for windows
for_window [shell="xdg_shell"] title_format "%title (%app_id)"
for_window [shell="x_wayland"] title_format "%class - %title"

# Set gaps for windows with rounded corners
for_window [class="^.*"] border $border
for_window [app_id="^.*"] border $border

for_window [class="^.*"] opacity $opacity
for_window [app_id="^.*"] opacity $opacity

client.focused           $green    $base $text  $green $green
client.focused_tab_title           $green    $base $text  $green $green
client.focused_inactive  $mantle       $base $text  $mantle $mantle
client.unfocused         $mantle        $base $text  $mantle $mantle
client.urgent            $peach        $base $peach $overlay0  $peach
client.placeholder       $base     $base $text  $overlay0  $overlay0
client.background        $base
