# exec ~/.config/sway/scripts/nvim.sh &

# ntfy listening
# exec ntfy sub -C &

# Welcome
exec dex -a -s /etc/xdg/autostart/:~/.config/autostart/

# Pipewire
exec pactl set-default-sink alsa_output.pci-0000_03_00.6.analog-stereo
exec pactl set-default-source alsa_input.pci-0000_03_00.5-platform-acp_yc_mach.0.stereo-fallback && pactl set-source-mute @DEFAULT_SOURCE@ 1

# tray applet
# exec blueman-applet

# exec nostr-relay-tray
# exec ~/.config/sway/scripts/nostr.sh &

exec thunar --daemon

# Sway Fader / unfocused
# exec ~/.config/sway/scripts/swayfader.py &
# exec ~/.config/sway/scripts/unfocused.py &

# Autotiling
exec autotiling


# usbguard 
exec usbguard-notify &

exec_always pidof sirula || sirula -d &

# Wlsunset
# exec ~/.config/sway/scripts/light.sh

# Clipman
# exec clipman restore
exec wl-paste -p -t text --watch clipman store -P --histpath="~/.local/share/clipman-primary.json"

# Xdg DEsktop Portal
exec_always ~/.config/sway/scripts/portals.sh

exec_always ~/.local/bin/check-update &

# Set Minimum Screen Brightness so the screen won't going black on 0
exec ~/.config/sway/scripts/restorebrightness.sh

exec ~/.config/sway/scripts/wobbar.sh &

exec swayrd
# exec clamd & sudo clamonacc

exec darkman run &


# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
   swaybar_command waybar
}
# Desktop notifications
exec_always ~/.config/sway/scripts/notifications &

exec ~/.config/sway/scripts/restart_bar.sh

# exec emacs --daemon

exec dex /etc/xdg/autostart/polkit-gnome-authentication-agent-1.desktop
