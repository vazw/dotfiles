# Switch to workspace
$bindcode $mod+1 [workspace="^1$"] move workspace to output current; workspace number 1
$bindcode $mod+2 [workspace="^2$"] move workspace to output current; workspace number 2
$bindcode $mod+3 [workspace="^3$"] move workspace to output current; workspace number 3
$bindcode $mod+4 [workspace="^4$"] move workspace to output current; workspace number 4
$bindcode $mod+5 [workspace="^5$"] move workspace to output current; workspace number 5
$bindcode $mod+6 [workspace="^6$"] move workspace to output current; workspace number 6
$bindcode $mod+7 [workspace="^7$"] move workspace to output current; workspace number 7
$bindcode $mod+8 [workspace="^8$"] move workspace to output current; workspace number 8
$bindcode $mod+9 [workspace="^9$"] move workspace to output current; workspace number 9
$bindcode $mod+0 [workspace="^10$"] move workspace to output current; workspace number 10
