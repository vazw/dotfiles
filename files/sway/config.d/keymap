#
# Layout stuff:
#
# You can "split" the current object of your focus with
# $mod+b or $mod+v, for horizontal and vertical splits
# respectively.
# $bindcode $mod+b splith
# $bindcode $mod+v splitv

# Switch the current container between different layout styles
# $bindcode $mod+s layout stacking
$bindcode $mod+Shift+w splith
# $bindcode $mod+Shift+e splitv
$bindcode $mod+w split none,layout tabbed
$bindcode $mod+e layout toggle split

# pin floating screen
$bindcode $mod+s sticky toggle

# Make the current focus fullscreen
$bindcode $mod+Shift+f fullscreen

# Toggle the current focus between tiling and floating mode
$bindcode $mod+space floating toggle

# Switch to the last recently used window
$bindcode $mod+Tab focus mode_toggle

# Swap focus between the tiling area and the floating area
$bindcode $mod+Shift+space exec swayr switch-to-urgent-or-lru-window

# Move focus to the parent container
