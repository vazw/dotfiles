#
# Scratchpad:
#
# Sway has a "scratchpad", which is a bag of holding for windows.
# You can send windows there and get them back later.

# Move the currently focused window to the scratchpad
# $bindcode $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
#$bindcode $mod+minus scratchpad show

# My Keybinding

# Move the currently focused window to the scratchpad
$bindcode $mod+Shift+equal move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
$bindcode $mod+equal scratchpad show



# Resizing containers:
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    $bindcode $left resize shrink width 10px
    $bindcode $down resize grow height 10px
    $bindcode $up resize shrink height 10px
    $bindcode $right resize grow width 10px

    # Ditto, with arrow keys
    $bindcode Left resize shrink width 10px
    $bindcode Down resize grow height 10px
    $bindcode Up resize shrink height 10px
    $bindcode Right resize grow width 10px

    # Return to default mode
    $bindcode Return mode "default"
    $bindcode Escape mode "default"
    $bindcode $mod+r mode "default"
}
$bindcode $mod+r mode "resize"

# Resize floating windows with mouse scroll:
$bindcode --whole-window --border $mod+button4 resize shrink height 5 px or 5 ppt
$bindcode --whole-window --border $mod+button5 resize grow height 5 px or 5 ppt
$bindcode --whole-window --border $mod+shift+button4 resize shrink width 5 px or 5 ppt
$bindcode --whole-window --border $mod+shift+button5 resize grow width 5 px or 5 ppt

# Volume

$bindcode XF86AudioRaiseVolume exec ~/.config/sway/scripts/volume --inc  
$bindcode XF86AudioLowerVolume exec ~/.config/sway/scripts/volume --dec 
$bindcode XF86AudioMute exec ~/.config/sway/scripts/volume --toggle
$bindcode XF86AudioMicMute exec ~/.config/sway/scripts/volume --toggle-mic
$bindcode XF86Tools exec ~/.config/sway/scripts/volume --toggle-mic

# Player

$bindcode XF86AudioPlay exec playerctl play
$bindcode XF86AudioPause exec playerctl pause
$bindcode XF86AudioNext exec playerctl next
$bindcode XF86AudioPrev exec playerctl previous

# Backlight

$bindcode XF86MonBrightnessUp exec ~/.config/sway/scripts/brightness --inc
$bindcode XF86MonBrightnessDown exec ~/.config/sway/scripts/brightness --dec
$bindcode XF86HomePage exec ~/.config/sway/scripts/brightness --inc 
$bindcode XF86Explorer exec ~/.config/sway/scripts/brightness --dec

$bindcode XF86Mail exec ghostty -e nvim ~/Documents/TODAY.md

