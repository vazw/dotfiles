# Logo key. Use Mod1 for Alt.
set $mod Mod4 
set $bindcode bindsym --to-code

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulators
set $term-float alacritty

# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
set $menu sirula

# set $launcher nwg-drawer -c 7 -is 70 -spacing 23
set $launcher wofi

set $powermenu ~/.config/sway/scripts/powermenu.sh

set $emoji ~/.config/sway/scripts/emoji.sh

set $cheat $term-float -t cheatsheet -e nvim ~/.config/sway/cheatsheet.md

# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

# Rotate output clockwise
$bindcode $mod+F9 output eDP-1 transform 0
$bindcode $mod+Ctrl+F9 output eDP-1 transform 90
# Rotate output anticlockwise
$bindcode $mod+Shift+F9 output eDP-1 transform 180

# Toggle between wallpapers
$bindcode $mod+Shift+b exec ~/.config/sway/scripts/background-swap.sh

# Toggle background waybar
# $bindcode $mod+Shift+w exec ~/.config/waybar/scripts/swap.sh


### Key bindings
#
# Basics:
#
$bindcode $mod+Return exec ghostty
$bindcode $mod+Shift+Return exec $term-float

# Open the power menu
$bindcode $mod+Shift+e exec $powermenu

# Kill focused window
$bindcode $mod+q kill

# Start your launcher
$bindcode $mod+d exec $menu

# Activities
$bindcode $mod+o exec swayr switch-window

# Activities and workspaces
$bindcode $mod+Shift+O exec swayr switch-workspace-or-window

# Cheatsheet
$bindcode $mod+Shift+i exec $cheat

#Color Picker
$bindcode $mod+c exec ~/.config/sway/scripts/colorpicker

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

# Reload the configuration file
$bindcode $mod+Shift+c reload
$bindcode $mod+t exec darkman toggle

#
# Moving around:
#
# Move your focus around
$bindcode $mod+$left focus left
$bindcode $mod+$down focus down
$bindcode $mod+$up focus up
$bindcode $mod+$right focus right
# Or use $mod+[up|down|left|right]
$bindcode $mod+Left focus left
$bindcode $mod+Down focus down
$bindcode $mod+Up focus up
$bindcode $mod+Right focus right

# Move the focused window with the same, but add Shift
$bindcode $mod+Shift+$left move left
$bindcode $mod+Shift+$down move down
$bindcode $mod+Shift+$up move up
$bindcode $mod+Shift+$right move right
# Ditto, with arrow keys
$bindcode $mod+Shift+Left move left
$bindcode $mod+Shift+Down move down
$bindcode $mod+Shift+Up move up
$bindcode $mod+Shift+Right move right
#
# Workspaces:
