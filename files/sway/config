# include catppuccin-mocha
# Config for sway
#
# Read `man 5 sway` for a complete reference.
exec dbus-update-activation-environment DISPLAY SWAYSOCK WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway QT_QPA_PLATFORM
exec wmname LG3D
# user config directory
include $HOME/.config/sway/config.d/*

# only enable this if every app you use is compatible with wayland
# xwayland disable

# Set the background image
# output * bg /home/vaz/.config/sway/backgrounds/4.jpg fill
output * bg /home/vaz/.config/sway/backgrounds/5.jpg fit

