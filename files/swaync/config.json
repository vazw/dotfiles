{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "bottom",
  "layer": "overlay",
  "control-center-margin-top": 5,
  "control-center-margin-bottom": 20,
  "control-center-margin-right": 5,
  "notification-icon-size": 64,
  "fit-to-screen": true,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-inline-replies": true,
  "notification-window-width": 500,
  "control-center-height": 900,
  "notification-2fa-action": true,
  "layer-shell": true,
  "timeout": 15,
  "timeout-low": 10,
  "timeout-critical": 20,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": ["title", "dnd", "notifications", "mpris", "buttons-grid", "volume", "backlight"],
  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰆴 Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟",
      "device": "amdgpu_bl0",
      "min": 1
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "active":true,
          "update-command": "bash -c '$HOME/.config/swaync/scripts/wifi.sh --check'",
          "command": "bash -c '$HOME/.config/swaync/scripts/wifi.sh --toggle'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active":true,
          "update-command": "bash -c '$HOME/.config/swaync/scripts/bluetooth.sh --check'",
          "command": "bash -c '$HOME/.config/swaync/scripts/bluetooth.sh --toggle'"
        },
        {
          "label": "󰕾",
          "type": "toggle",
          "active":true,
          "update-command": "sh -c '$HOME/.config/swaync/scripts/sink.sh --check'",
          "command": "sh -c '$HOME/.config/swaync/scripts/sink.sh --toggle'"
        },

        {
          "label": "󰍬",
          "type": "toggle",
          "active":true,
          "update-command": "bash -c '$HOME/.config/swaync/scripts/source.sh --check'",
          "command": "bash -c '$HOME/.config/swaync/scripts/source.sh --toggle'"
        },

        {
          "label": "󰹑",
          "type": "normal",
          "active": false,
          "command": "sh -c 'swaync-client -t -sw;home/vaz/.config/sway/scripts/screenshot.sh'"
        },
        {
          "label": "󱎴",
          "type": "normal",
          "active": false,
          "command": "sh -c 'swaync-client -t -sw;swayr switch-window'"
        },
        {
          "label": "󱑞",
          "type": "normal",
          "active": false,
          "command": "sh -c 'swaync-client -t -sw;swaync-client -R'"
        },
        {
          "label": "",
          "type": "normal",
          "active": false,
          "command": "sh -c 'swaync-client -t -sw;kitty --class float -e btop'"
        },
        {
          "label": "󰌾",
          "type": "normal",
          "active": false,
          "command": "bash -c 'swaync-client -t -sw;$HOME/.config/wlogout/actions --lock'"
        },
        {
          "label": "",
          "type": "normal",
          "active": false,
          "command": "bash -c 'swaync-client -t -sw;$HOME/.config/wlogout/actions --reboot'"
        },
        {
          "label": "󰛧",
          "type": "normal",
          "active": false,
          "command": "bash -c 'swaync-client -t -sw;$HOME/.config/wlogout/actions --suspend'"
        },
        {
          "label": "󰒲",
          "type": "normal",
          "active": false,
          "command": "bash -c 'swaync-client -t -sw;$HOME/.config/wlogout/actions --hibernate'"
        },
        {
          "label": "󰍃",
          "type": "normal",
          "active": false,
          "command": "bash -c 'swaync-client -t -sw;$HOME/.config/wlogout/actions --logout'"
        },
        {
          "label": "⏻",
          "type": "normal",
          "active": false,
          "command": "bash -c 'swaync-client -t -sw;$HOME/.config/wlogout/actions --shutdown'"
        }
      ]
    }
  }
}
